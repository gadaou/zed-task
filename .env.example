# cart_system — environment variable template
#
# Copy to ``.env`` (gitignored) and adjust for your local environment:
#
#     cp .env.example .env
#
# Every variable listed here is read in ``cart_system/settings/base.py``.
# Add a comment for any new variable you introduce.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# Which settings module to load. Defaults are wired in manage.py (dev) and
# wsgi/asgi (prod), so this is only required if you want to override.
DJANGO_SETTINGS_MODULE=cart_system.settings.dev

# Required in production. The dev settings provide an insecure fallback.
DJANGO_SECRET_KEY=change-me-please-generate-a-real-secret

# Boolean. Never set to True in production.
DJANGO_DEBUG=True

# Comma-separated list. Empty in dev, exact hostnames in prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Default UTC; override only for local debugging of timezone-sensitive code.
DJANGO_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Database (PROJECT_SPEC §3.1 — single shared PostgreSQL)
# ---------------------------------------------------------------------------

# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://cart_user:cart_pass@localhost:5432/cart_system

# ---------------------------------------------------------------------------
# Logging (PROJECT_SPEC §6.3)
# ---------------------------------------------------------------------------

DJANGO_LOG_LEVEL=INFO
DJANGO_DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Production hardening (only consulted by cart_system.settings.prod)
# ---------------------------------------------------------------------------

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=2592000

# ---------------------------------------------------------------------------
# Redis + Celery (PROJECT_SPEC §4.4 distributed locks, §4.6 async workers)
# ---------------------------------------------------------------------------

# Redis connection URL. Used for:
#   - Distributed checkout lock (lock:checkout:{tenant}:{cart}) — PROJECT_SPEC §4.4
#   - Idempotency in-progress guard (idem:{tenant}:{key})       — PROJECT_SPEC §4.5
#   - Celery broker (db/1) and result backend (db/2)            — PROJECT_SPEC §4.6
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# How long to hold the checkout Redis lock (milliseconds).
# Must be > worst-case checkout latency (DB + gateway timeout + safety margin).
# Default: 15 seconds — covers 8s gateway budget + 2s DB + 5s margin.
CHECKOUT_LOCK_TTL_MS=15000

# How long to mark an idempotency key as "in_progress" in Redis (seconds).
# A client that retries before this expires gets 409 idempotency/in-progress.
IDEMPOTENCY_INPROGRESS_TTL_S=60

# How long durable IdempotencyRecord rows are retained before the Celery
# beat sweep deletes them (hours). PROJECT_SPEC §4.5 mandates 24h.
IDEMPOTENCY_RECORD_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Cart read cache (PROJECT_SPEC §5.2 — hot-path caching)
# ---------------------------------------------------------------------------

# TTL for cart read-response cache entries (seconds).
# Explicit DEL fires on every mutation via transaction.on_commit, so the TTL
# is only a safety net for lost DELs during Redis blips.
CART_CACHE_TTL_S=60

# Master kill-switch for the cart cache.  Set to False to bypass Redis and
# always read from Postgres — useful for debugging stale-data issues without
# a redeploy.
CART_CACHE_ENABLED=True
