# cart_system — environment variable template
#
# Copy to ``.env`` (gitignored) and adjust for your local environment:
#
#     cp .env.example .env
#
# Every variable listed here is read in ``cart_system/settings/base.py``.
# Add a comment for any new variable you introduce.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# Which settings module to load. Defaults are wired in manage.py (dev) and
# wsgi/asgi (prod), so this is only required if you want to override.
DJANGO_SETTINGS_MODULE=cart_system.settings.dev

# Required in production. The dev settings provide an insecure fallback.
DJANGO_SECRET_KEY=change-me-please-generate-a-real-secret

# Boolean. Never set to True in production.
DJANGO_DEBUG=True

# Comma-separated list. Empty in dev, exact hostnames in prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Default UTC; override only for local debugging of timezone-sensitive code.
DJANGO_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Database (PROJECT_SPEC §3.1 — single shared PostgreSQL)
# ---------------------------------------------------------------------------

# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://cart_user:cart_pass@localhost:5432/cart_system

# ---------------------------------------------------------------------------
# Logging (PROJECT_SPEC §6.3)
# ---------------------------------------------------------------------------

DJANGO_LOG_LEVEL=INFO
DJANGO_DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Production hardening (only consulted by cart_system.settings.prod)
# ---------------------------------------------------------------------------

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=2592000

# ---------------------------------------------------------------------------
# Reserved for upcoming iterations — left here so reviewers can see the shape
# of the final stack at a glance. Do NOT set these yet; the code does not
# read them until the iteration that introduces the dependency.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
